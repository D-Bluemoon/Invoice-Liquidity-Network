# =============================================================================
# .npmrc — root npm configuration
#
# This is a pnpm-only workspace. npm and yarn must not be used to install
# dependencies here. The settings below prevent accidental npm/yarn runs
# from silently generating stray lockfiles.
# =============================================================================

# Refuse to run if the node engine constraint in package.json is not met.
engine-strict=true

# Tell npm never to write a package-lock.json. Even if someone runs `npm
# install` by mistake, it will not generate a lockfile that can be
# accidentally committed and diverge from pnpm-lock.yaml.
package-lock=false

# Prevent npm from writing a shrinkwrap file (the older lockfile format).
shrinkwrap=false
